{
  "manifest_version": 3,
  "name": "TradingView Strategy Scraper",
  "version": "1.0",
  "description": "Extract performance metrics and trade lists from TradingView Strategy Reports.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/chart/*",
        "https://www.tradingview.com/chart?*"
      ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
